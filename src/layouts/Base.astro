---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import {
  alternateUrls,
  homeUrl,
  languages,
  LANGUAGE_STORAGE_KEY,
  partUrl,
  repositoryUrl,
  sites,
  type Language,
} from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang: Language;
  /** Position des Teils in der Navigation, null auf der Startseite. */
  index: number | null;
  /**
   * Besucher ohne Deutsch einmalig auf die englische Startseite schicken.
   * Nur auf der deutschen Startseite sinnvoll – sie ist der einzige Einstieg
   * ohne ausgesprochenen Sprachwunsch.
   */
  detectLanguage?: boolean;
}

const { title, description, lang, index, detectLanguage = false } = Astro.props;

const site = sites[lang];
const ui = site.ui;
const alternates = alternateUrls(index);
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      languages.map((other) => (
        <link rel="alternate" hreflang={other} href={alternates[other]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates.de} />
    {
      detectLanguage && (
        <script
          is:inline
          define:vars={{ englishUrl: homeUrl('en'), storageKey: LANGUAGE_STORAGE_KEY }}
        >
          // Läuft bewusst vor dem Rendern, damit die deutsche Seite nicht kurz aufblitzt.
          try {
            const chosen = localStorage.getItem(storageKey);
            const tags = navigator.languages || [navigator.language || 'de'];
            const wantsGerman = tags.some((tag) => tag.toLowerCase().startsWith('de'));

            // Eine Wahl im Umschalter hat immer Vorrang vor der Browsersprache.
            if (chosen === 'en' || (!chosen && !wantsGerman)) {
              location.replace(englishUrl);
            }
          } catch {
            // Ohne localStorage bleibt es bei der deutschen Fassung.
          }
        </script>
      )
    }
    <title>{title}</title>
  </head>
  <body data-copy={ui.copy} data-copied={ui.copied} data-copy-failed={ui.copyFailed}>
    <header class="site-header">
      <a class="wordmark" href={homeUrl(lang)}>{ui.wordmark}</a>
      <nav class="site-nav" aria-label={ui.navLabel}>
        {
          site.parts.map((part, i) => (
            <a
              href={partUrl(lang, i)}
              aria-current={currentPath === partUrl(lang, i).replace(/\/$/, '') ? 'page' : undefined}
            >
              <span class="nav-number">{part.number}</span>
              {part.label}
            </a>
          ))
        }
      </nav>
    </header>

    <slot />

    <dialog class="lightbox" aria-label={ui.lightbox}>
      <img alt="" />
    </dialog>

    <script>
      const lightbox = document.querySelector('dialog.lightbox');
      const lightboxImage = lightbox?.querySelector('img');

      if (lightbox instanceof HTMLDialogElement && lightboxImage instanceof HTMLImageElement) {
        const zooms = document.querySelectorAll<HTMLButtonElement>('.prose button.zoom');

        for (const zoom of zooms) {
          zoom.addEventListener('click', () => {
            const image = zoom.querySelector('img');
            if (!(image instanceof HTMLImageElement)) return;
            lightboxImage.src = image.src;
            lightboxImage.alt = image.alt;
            lightbox.showModal();
          });
        }

        lightbox.addEventListener('click', () => lightbox.close());

        // Auf schmalen Bildschirmen bringt das Vergrößern nichts: Das Bild füllt
        // dort ohnehin die ganze Breite. Gleicher Haltepunkt wie beim Inhaltsverzeichnis.
        const wide = window.matchMedia('(min-width: 64rem)');

        const syncZoom = () => {
          for (const zoom of zooms) zoom.disabled = !wide.matches;
          if (!wide.matches) lightbox.close();
        };

        wide.addEventListener('change', syncZoom);
        syncZoom();
      }
    </script>

    <script>
      // Wer die Sprache selbst wählt, soll nicht bei jedem Besuch zurückgeschickt werden.
      for (const link of document.querySelectorAll('.site-langs a[hreflang]')) {
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('tutorial-lang', link.getAttribute('hreflang') ?? '');
          } catch {
            // Ohne localStorage merken wir uns die Wahl eben nicht.
          }
        });
      }
    </script>

    <script>
      // Die Beschriftungen kommen aus dem Layout, damit das Skript für alle Sprachen gilt.
      const labels = document.body.dataset;
      const copy = labels.copy ?? 'Kopieren';

      const blocks = document.querySelectorAll(
        '.prose pre[data-language="bash"], .prose pre[data-language="powershell"], .prose pre[data-language="prompt"]',
      );

      for (const pre of blocks) {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        pre.replaceWith(wrapper);
        wrapper.append(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-button';
        button.textContent = copy;
        wrapper.append(button);

        let reset = 0;
        button.addEventListener('click', async () => {
          const text = pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text.trim());
            button.textContent = labels.copied ?? 'Kopiert';
          } catch {
            button.textContent = labels.copyFailed ?? 'Nicht möglich';
          }
          clearTimeout(reset);
          reset = setTimeout(() => (button.textContent = copy), 2000);
        });
      }
    </script>

    <footer class="site-footer">
      <span>{ui.footer}</span>
      <a class="footer-source" href={repositoryUrl}>{ui.source}</a>
      <nav class="site-langs" aria-label={ui.langLabel}>
        {
          languages.map((other) => (
            <a
              href={alternates[other]}
              hreflang={other}
              lang={other}
              aria-current={other === lang ? 'true' : undefined}
            >
              <abbr title={sites[other].name}>{other.toUpperCase()}</abbr>
            </a>
          ))
        }
      </nav>
    </footer>
  </body>
</html>
