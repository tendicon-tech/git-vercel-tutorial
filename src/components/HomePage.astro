---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { defaultLanguage, sites, type Language } from '../lib/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const site = sites[lang];

const entry = await getEntry('inhalte', `${lang}/${site.home}`);
if (!entry) throw new Error(`Inhalt "${lang}/${site.home}" fehlt.`);

const { Content } = await render(entry);
const [heroFirst, heroSecond] = site.ui.heroTitle;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  index={null}
  detectLanguage={lang === defaultLanguage}
>
  <section class="hero">
    <div class="hero-shape" aria-hidden="true"></div>
    <div class="hero-block" aria-hidden="true"></div>
    <h1 class="hero-title">
      {heroFirst}<br />{heroSecond}
    </h1>
    <p class="hero-lead">{entry.data.description}</p>
  </section>

  <main class="page page-home">
    <article class="prose">
      <Content />
    </article>
  </main>
</Base>
