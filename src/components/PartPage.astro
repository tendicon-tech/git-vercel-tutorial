---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { homeUrl, partUrl, sites, type Language } from '../lib/i18n';

interface Props {
  lang: Language;
  index: number;
}

const { lang, index } = Astro.props;
const site = sites[lang];
const part = site.parts[index];

const entry = await getEntry('inhalte', `${lang}/${part.slug}`);
if (!entry) throw new Error(`Inhalt "${lang}/${part.slug}" fehlt.`);

const { Content, headings } = await render(entry);

const prev = site.parts[index - 1];
const next = site.parts[index + 1];

// "Teil 1 – Einrichtung der Entwicklungsumgebung" → "Einrichtung der Entwicklungsumgebung"
const heading = entry.data.title.split(' – ').slice(1).join(' – ') || entry.data.title;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={entry.data.title} description={entry.data.description} lang={lang} index={index}>
  <section class="part-hero">
    <div class="part-number" aria-hidden="true">{part.number}</div>
    <h1 class="part-title">{heading}</h1>
  </section>

  <main class="page page-part">
    <aside class="toc">
      <nav aria-label={site.ui.tocLabel}>
        <ol>
          {
            toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <article class="prose">
      <Content />
    </article>
  </main>

  <nav class="pager" aria-label={site.ui.pagerLabel}>
    {
      prev ? (
        <a class="pager-link pager-prev" href={partUrl(lang, index - 1)}>
          <span class="pager-direction">{site.ui.prev}</span>
          <span class="pager-label">
            {prev.number} {prev.label}
          </span>
        </a>
      ) : (
        <a class="pager-link pager-prev" href={homeUrl(lang)}>
          <span class="pager-direction">{site.ui.prev}</span>
          <span class="pager-label">{site.ui.home}</span>
        </a>
      )
    }
    {
      next ? (
        <a class="pager-link pager-next" href={partUrl(lang, index + 1)}>
          <span class="pager-direction">{site.ui.next}</span>
          <span class="pager-label">
            {next.number} {next.label}
          </span>
        </a>
      ) : (
        <a class="pager-link pager-next" href={homeUrl(lang)}>
          <span class="pager-direction">{site.ui.done}</span>
          <span class="pager-label">{site.ui.homeLong}</span>
        </a>
      )
    }
  </nav>
</Base>
